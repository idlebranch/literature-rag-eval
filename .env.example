# ── OpenAI-compatible API config ──
# Used by: src/config.py, src/eval/runner.py (generation), src/eval_answer_judge.py
OPENAI_API_KEY=replace_with_your_key
OPENAI_BASE_URL=https://anyrouter.top/v1
LLM_MODEL=gpt-5.5

# ── Local embedding model ──
# Used by: src/config.py  →  src/embedder.py
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_LOCAL_FILES_ONLY=true

# ── Judge model (optional overrides; fallback to OPENAI_API_KEY / LLM_MODEL) ──
# Used by: src/eval/runner.py, src/eval_answer_judge.py
# If unset, the judge reuses OPENAI_API_KEY, OPENAI_BASE_URL, and LLM_MODEL.
JUDGE_OPENAI_API_KEY=replace_with_your_key
JUDGE_OPENAI_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=gpt-4o

# ── RAG config ──
# Used by: src/config.py  →  src/vectorstore.py, src/chunking.py
PDF_DIR=./data/papers/final_corpus
CHROMA_DIR=./chroma_db_section_aware_270_gpu
COLLECTION_NAME=section_aware_270_gpu
CHUNKING_MODE=section_aware
RETRIEVAL_MODE=hybrid_dense_sparse
SPARSE_INDEX_DIR=./sparse_index_section_aware_270_gpu
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Cosine distance above this value is treated as insufficient evidence.
MAX_RETRIEVAL_DISTANCE=1.15
CONTEXT_TOKEN_BUDGET=3000
QUERY_CACHE_SIZE=128
RETRIEVAL_CACHE_SIZE=128

# Reused OpenAI-compatible HTTP client and bounded retry policy.
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=120
LLM_MAX_RETRIES=1
PERFORMANCE_DEBUG=false

# ── Local service ports ──
# 8010 intentionally avoids the Multi-Agent BI service on port 8000.
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8010
RAG_UI_PORT=8501
RAG_EVAL_PORT=8502

# Request traces may contain questions, answers, and retrieved snippets.
# Keep disabled by default; enable explicitly for interview debugging.
TRACING_ENABLED=false

# ── Logging ──
# Used by: src/utils/logging.py
# Set to DEBUG for verbose output, WARNING to suppress info.
LOG_LEVEL=INFO
